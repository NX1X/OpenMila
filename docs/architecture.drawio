        <!-- Row 3: Platform implementations -->
        <mxCell id="linuxBox" value="&lt;b&gt;LinuxPlatform&lt;/b&gt;&lt;br&gt;Port/LinuxPlatform &amp;middot; &lt;b&gt;new in the port&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; miniaudio, mic &amp;amp; mixed capture&lt;br&gt;&amp;#8226; PipeWire, per-app audio (pw-record --target)&lt;br&gt;&amp;#8226; XDG portals, GlobalShortcuts, RemoteDesktop&lt;br&gt;&amp;#8226; X11 / XWayland, hotkeys, window titles&lt;br&gt;• AT-SPI accessibility bus, window titles on Wayland&lt;br&gt;&amp;#8226; libsecret, Secret Service keyring&lt;br&gt;&amp;#8226; logind / systemd-inhibit, sleep guard&lt;br&gt;&amp;#8226; inotify, watched folders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E6F2FF;strokeColor=#0057D8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=18;spacingTop=14;fontFamily=Helvetica;fontSize=14;fontColor=#121417;" vertex="1" parent="1">
